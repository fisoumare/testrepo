# Tests sur MySQL (facultatif). Par défaut, `php artisan test` tourne sur SQLite en mémoire (phpunit.xml).
#
# 1. Créer la base de test, distincte de la base de développement « soumatic » :
#      mysql -u root -e "CREATE DATABASE soumatic_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
# 2. Copier ce fichier en .env.testing (Windows : copy .env.testing.example .env.testing)
#    puis lui donner sa propre clé : php artisan key:generate --env=testing
# 3. Lancer : php artisan test --env=testing
#
# ATTENTION : les tests vident et recréent toutes les tables de la base indiquée ci-dessous.
# Ne mettez jamais DB_DATABASE=soumatic ici.
#
# Dès que .env.testing existe, les tests le lisent à la place de .env (APP_ENV=testing) : sans
# --env=testing, ils restent sur SQLite en mémoire mais prennent la clé APP_KEY de ce fichier.

APP_NAME=SOUMATIC
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

ADMIN_NAME="Fodé Idrissa SOUMARÉ"
ADMIN_EMAIL=fisoumare@soumatic.com
ADMIN_PASSWORD=

TRUSTED_PROXIES=*

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soumatic_test
DB_USERNAME=root
DB_PASSWORD=

MAIL_FROM_ADDRESS="noreply@soumatic.com"
MAIL_FROM_NAME="SOUMATIC"
