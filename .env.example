APP_NAME=SOUMATIC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Adresse du site : http://soumatic.test sous Laragon, http://localhost:8000 avec `php artisan serve`.
APP_URL=http://soumatic.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Compte administrateur créé une seule fois par `php artisan db:seed` (AdminUserSeeder).
# ADMIN_PASSWORD vide : un mot de passe aléatoire est généré et affiché une seule fois par le seeder.
# Un mot de passe renseigné est utilisé tel quel (« password » est refusé en production).
# Il se change ensuite depuis /admin/users.
ADMIN_NAME="Fodé Idrissa SOUMARÉ"
ADMIN_EMAIL=fisoumare@soumatic.com
ADMIN_PASSWORD=

# Proxys de confiance (reverse proxy, CDN) dont les en-têtes X-Forwarded-* sont lus : « * » pour tous,
# une liste d'adresses IP séparées par des virgules pour n'accepter qu'elles, vide pour aucun.
TRUSTED_PROXIES=*

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8 (Laragon : utilisateur root, mot de passe vide). Créer la base en utf8mb4_unicode_ci avant
# `php artisan migrate --seed` (voir README). Jamais de `migrate:fresh` ni de tests sur cette base.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soumatic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@soumatic.com"
MAIL_FROM_NAME="SOUMATIC"
# L'adresse qui reçoit les demandes du site (devis et contact) ne se règle pas ici :
# back-office → Paramètres du site → Coordonnées → « E-mail de notification ».

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
